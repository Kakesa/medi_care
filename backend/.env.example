# Copier ce fichier vers backend/.env puis remplacer les valeurs.
# Ne jamais y placer le mot de passe du superadmin : le passer uniquement
# en variable d'environnement le temps de la commande create-superadmin.

PORT=3001
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/medicare
JWT_SECRET=remplacer-par-une-chaine-aleatoire-d-au-moins-32-caracteres
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:8080
BCRYPT_ROUNDS=12
LOGIN_RATE_LIMIT_MAX=10
